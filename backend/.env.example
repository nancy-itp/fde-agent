DATABASE_URL=postgresql+psycopg2://fde_user:fde_password@localhost:5432/fde_platform
ENVIRONMENT=development
JWT_SECRET_KEY=changeme-generate-a-random-secret-for-local-dev
CORS_ALLOW_ORIGINS=http://localhost:5173

# PRIO MCP connector (docs/PRIO_MCP_CONNECTOR.md) — staging only, local dev use.
# Never a real value here in staging/production: use the secrets manager there.
# PRIO_MCP_BASE_URL is the full MCP endpoint (includes the /mcp path), not a bare origin.
PRIO_MCP_BASE_URL=
PRIO_MCP_TOKEN=
# Not read by code — human reference only (rotation contact point + renewal reminder).
PRIO_MCP_TOKEN_REF=
PRIO_MCP_TOKEN_EXPIRES=
